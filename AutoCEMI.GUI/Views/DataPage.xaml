<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AutoCEMI.GUI.Views.DataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AutoCEMI.GUI.Views"
    xmlns:m="using:AutoCEMI.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="RootPage">

    <ScrollViewer>
        <Grid Padding="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <Button x:Name="GoBack_Button" 
                Click="GoBack_Button_Click"
                Margin="0,0,8,0">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">AutoCEMI data page</TextBlock>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">User Profile</TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,4,0">Time played:</TextBlock>
                    <TextBlock Text="{Binding DataService.Profile.PlayTime}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">IWADs</TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button Click="AddIwads_Button_Click" Content="Add" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding DataService.iwads}"
                        x:Name="Iwads_ItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:Iwad">
                            <Grid ColumnDefinitions="*,Auto"
                        Margin="0,4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Path}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                Command="{Binding DataContext.RemoveIwadCommand, ElementName=SourcePorts_ItemsControl}"
                                CommandParameter="{x:Bind}">
                                    <FontIcon Glyph="&#xE894;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">Source ports</TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button Click="AddSourcePorts_Button_Click" Content="Add" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding DataService.sourcePorts}"
                        x:Name="SourcePorts_ItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:SourcePort">
                            <Grid ColumnDefinitions="*,Auto"
                            Margin="0,4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Path}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                Command="{Binding DataContext.RemovePortCommand, ElementName=SourcePorts_ItemsControl}" 
                                CommandParameter="{x:Bind}">
                                    <FontIcon Glyph="&#xE894;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Row="4">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}">Mods</TextBlock>

                <StackPanel Orientation="Horizontal">
                    <Button Click="AddMods_Button_Click" Content="Add" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding DataService.mods}"
                          x:Name="Mods_ItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="m:Mod">
                            <Grid ColumnDefinitions="*,Auto"
                                Margin="0,4">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind Path}" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                    Command="{Binding DataContext.RemoveModCommand, ElementName=Mods_ItemsControl}"
                                    CommandParameter="{x:Bind}">
                                    <FontIcon Glyph="&#xE894;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
